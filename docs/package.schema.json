{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pustka.sh/schemas/documentation-package-v1.json",
  "title": "pustka documentation package, version 1",
  "description": "Project-owned Markdown guides and source-extracted API documentation. The server additionally validates unique identifiers, source ref/version identity, trusted project/repository and the 8 MiB package limit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "version", "source", "generatedAt", "pages", "api"],
  "properties": {
    "schemaVersion": {"const": 1},
    "project": {"$ref": "#/$defs/project"},
    "version": {"type": "string", "pattern": "^(main|v?[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}(-[A-Za-z0-9][A-Za-z0-9.-]{0,49})?)$"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["commit", "ref"],
      "properties": {"commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "ref": {"type": "string", "minLength": 1, "maxLength": 200}}
    },
    "generatedAt": {"type": "string", "format": "date-time"},
    "pages": {"type": "array", "maxItems": 150, "items": {"$ref": "#/$defs/page"}},
    "api": {"$ref": "#/$defs/api"}
  },
  "$defs": {
    "project": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "repository"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "repository": {"type": "string", "maxLength": 200, "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}
      }
    },
    "sourcePath": {
      "type": "string", "minLength": 1, "maxLength": 500,
      "description": "Repository-relative POSIX path. Empty, dot and parent segments, backslashes, percent escapes, controls and URL delimiters are rejected.",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\\\u0000-\\u001f\\u007f:#?%]+$"
    },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["slug", "title", "kind", "markdown", "sourcePath"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$", "not": {"const": "api"}},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"const": "guide"},
        "markdown": {"type": "string", "maxLength": 262144},
        "sourcePath": {"$ref": "#/$defs/sourcePath"}
      }
    },
    "api": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "language", "generator", "symbols"],
      "properties": {
        "schemaVersion": {"const": 1},
        "language": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,29}$"},
        "generator": {"type": "string", "minLength": 1, "maxLength": 100},
        "symbols": {"type": "array", "maxItems": 12000, "items": {"$ref": "#/$defs/symbol"}}
      }
    },
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 150},
        "type": {"type": "string", "maxLength": 1500},
        "description": {"type": "string", "maxLength": 32768, "default": ""}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {"type": {"type": "string", "maxLength": 1500}, "description": {"type": "string", "maxLength": 32768, "default": ""}}
    },
    "symbol": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "qualifiedName", "signature", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 2000},
        "kind": {"enum": ["class", "interface", "enum", "record", "annotation", "constructor", "method", "field", "enum-constant"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "qualifiedName": {"type": "string", "maxLength": 2000},
        "owner": {"type": "string", "maxLength": 1500, "default": ""},
        "signature": {"type": "string", "maxLength": 4000},
        "stability": {"enum": ["supported", "experimental", "internal"], "description": "Optional, author-declared integration policy. Visibility does not imply compatibility."},
        "stabilityNote": {"type": "string", "maxLength": 1000},
        "summary": {"type": "string", "maxLength": 16384, "default": ""},
        "description": {"type": "string", "maxLength": 65536, "default": ""},
        "parameters": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/parameter"}, "default": []},
        "returns": {"anyOf": [{"$ref": "#/$defs/result"}, {"type": "null"}], "default": null},
        "throws": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/result"}, "default": []},
        "since": {"type": "string", "maxLength": 2000, "default": ""},
        "deprecated": {"type": "boolean", "default": false},
        "deprecation": {"type": "string", "maxLength": 16384, "default": ""},
        "source": {
          "type": "object", "additionalProperties": false, "required": ["path", "line"],
          "properties": {"path": {"$ref": "#/$defs/sourcePath"}, "line": {"type": "integer", "minimum": 1, "maximum": 10000000}}
        }
      }
    }
  }
}
