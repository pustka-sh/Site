# Copy to .env on the Docker host. Never commit .env.
PUBLIC_ORIGIN=https://pustka.sh
HOST_PORT=3000
# Optional settings for compose.registry.yml (ready-built images).
SITE_IMAGE=ghcr.io/pustka-sh/site:latest
BIND_ADDRESS=127.0.0.1
# Trust only the actual reverse-proxy address/range. Empty = trust no proxies.
TRUST_PROXY=

# Optional: read-only GitHub token to increase the public API rate limit.
GITHUB_TOKEN=
# Add a high-entropy secret to Relay's GitHub push webhook and here.
GITHUB_WEBHOOK_SECRET=
DOCS_SYNC_ENABLED=true
DOCS_SYNC_ON_START=true
DOCS_SYNC_INTERVAL_MINUTES=360
# Signed documentation packages: one independent random key per project.
# Copy Relay's key into its PUSTKA_DOCS_PUBLISH_KEY GitHub Actions secret.
# Example shape only: {"relay":"a-random-key-of-at-least-32-characters"}
DOCS_PUBLISH_KEYS={}
SHARE_TTL_DAYS=30

# Optional anonymous documentation reports. Use a separate fine-grained token
# limited to Issues:write on this repository; leave disabled until configured.
ENABLE_ISSUE_REPORTS=false
ISSUE_REPOSITORY=pustka-sh/Relay
ISSUE_GITHUB_TOKEN=

# Optional read-only demo. This is the DASHBOARD HTTP address and a dashboard
# account. Never put the Relay proxy control-channel token in these fields.
DEMO_DASHBOARD_URL=
DEMO_DASHBOARD_USERNAME=
DEMO_DASHBOARD_PASSWORD=
# Only for a separate authenticated reverse proxy, not Relay control auth:
DEMO_DASHBOARD_AUTHORIZATION=
