{
  "name": "pustka-site",
  "private": true,
  "version": "2.0.0",
  "description": "The website for pustka: a Minecraft software workshop.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs && node scripts/feed.mjs",
    "preview": "vite preview",
    "sync": "node scripts/sync-relay.mjs",
    "docs:package": "node scripts/package-docs.mjs",
    "docs:publish": "node scripts/publish-docs.mjs",
    "start": "node server/index.mjs",
    "server": "node --watch server/index.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "github-slugger": "^2.0.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.11.1",
    "ipaddr.js": "^2.5.0",
    "katex": "^0.19.1",
    "marked": "^16.4.2",
    "motion": "^14.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
